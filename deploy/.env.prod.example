# Copy to .env.prod (never committed) and fill in. Used by deploy/compose.prod.yaml.

# The address of the site. Its DNS record (A/AAAA) must point to this server.
LFL_DOMAIN=luck.example.com

# "https": the bundled Caddy serves the site on ports 80/443 with automatic HTTPS.
# Leave empty when your own web server (Apache, nginx) is in front of 127.0.0.1:8090.
COMPOSE_PROFILES=https

# Long random secret: openssl rand -hex 32 (deploy.sh creates one if empty).
APP_SECRET=

# "browser": each visitor keeps their grids in a cookie (public site, no accounts).
# "server": one shared list on the server (private install only).
LFL_GRIDS=browser

# Optional audience measurement, behind a consent banner: a Google Analytics 4 ID
# (G-…) or a Google Tag Manager container (GTM-…). Nothing loads before consent.
LFL_GA4_ID=
LFL_GTM_ID=

# Optional: country of the mandatory gambling warning (be, fr…); empty = from the browser.
LFL_COUNTRY=

# Optional: language of the command-line output (en, fr, nl, es, de).
LFL_LOCALE=
