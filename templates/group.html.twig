{% extends '_lottery.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% set shape = lottery.definition.bonusShape %}
{% set label = bonus_label(lottery, params.bonus) %}
{% block title %}{{ 'nav.group'|trans }} – {{ lottery.name }}{% endblock %}
{% block stage_title %}{{ 'group.title'|trans }}{% endblock %}
{% block stage_lead %}{{ 'group.lead'|trans }}{% endblock %}
{% block content %}
<section class="block block--wide">
    <form class="controls">
        <label>{{ 'group.people'|trans }} <input type="number" name="people" min="1" max="100" value="{{ params.people }}" class="w-sm"></label>
        <label>{{ 'group.tickets'|trans }} <input type="number" name="tickets" min="1" max="1000" value="{{ params.tickets }}" class="w-sm"></label>
        <label>{{ 'group.numbers'|trans }}
            <select name="numbers" class="w-sm">{% for n in lottery.game.mainPicked..maxMain %}<option {{ n == params.numbers ? 'selected' }}>{{ n }}</option>{% endfor %}</select>
        </label>
        <label>{{ bonus_label(lottery)|capitalize }}
            <select name="bonus" class="w-sm">{% for n in lottery.game.bonusPicked..maxBonus %}<option {{ n == params.bonus ? 'selected' }}>{{ n }}</option>{% endfor %}</select>
        </label>
        <label>{{ 'budget.price'|trans }} <input type="number" name="price" step="0.05" min="0.5" max="50" value="{{ params.price }}" class="w-sm"></label>
        <label>{{ 'budget.years'|trans }} <input type="number" name="years" min="1" max="30" value="{{ params.years }}" class="w-sm"></label>
        <button class="btn"><svg class="icon"><use href="#i-group"/></svg> {{ 'group.compute'|trans }}</button>
    </form>
    {% if tooBig %}<p class="neg small" style="margin-top: 6px">{{ 'group.too_big'|trans({count: result.combinations|integer}) }}</p>{% endif %}
</section>

<section class="block">
    <div class="block__head">
        <h2>{{ 'group.tickets_title'|trans({count: params.tickets}) }}</h2>
        <p>{{ result.perTicket > 1
            ? 'group.ticket_text'|trans({numbers: params.numbers, bonus: params.bonus, label: label, picked: lottery.game.mainPicked, bonusPicked: lottery.game.bonusPicked, count: result.perTicket})
            : 'group.ticket_simple'|trans }}</p>
    </div>
    <div>
        <ul class="list">
            {% for ticket in examples %}
                {% set text = ticket.main|join(' ') ~ ' + ' ~ ticket.bonus|join(' ') %}
                <li>
                    <span class="list__index">{{ loop.index }}</span>
                    {{ ui.balls(ticket, shape, null, params.tickets > 12 ? '' : 'lg') }}
                    <span class="grow"></span>
                    <form method="post" action="{{ path('grids_add', {lottery: lottery.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('grids') }}">
                        <input type="hidden" name="grid" value="{{ text }}">
                        <button class="btn btn--ghost btn--sm" title="{{ 'generate.save_title'|trans }}"><svg class="icon"><use href="#i-save"/></svg> {{ 'generate.save'|trans }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 14px">
            {% if examples|length > 1 %}
                <form method="post" action="{{ path('grids_add', {lottery: lottery.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('grids') }}">
                    {% for ticket in examples %}<input type="hidden" name="grids[]" value="{{ ticket.main|join(' ') ~ ' + ' ~ ticket.bonus|join(' ') }}">{% endfor %}
                    <button class="btn btn--sm"><svg class="icon"><use href="#i-save"/></svg> {{ 'group.save_all'|trans({count: examples|length}) }}</button>
                </form>
            {% endif %}
            <p class="small muted">{{ params.tickets > examples|length ? 'group.tickets_more'|trans({count: params.tickets - examples|length}) : 'group.tickets_random'|trans }}</p>
        </div>
        <dl class="figures" style="margin-top: 22px">
            <div class="figure"><dt>{{ 'group.combinations'|trans }}</dt><dd>{{ result.combinations|integer }}</dd></div>
            <div class="figure"><dt>{{ 'group.cost'|trans }}</dt><dd>{{ result.cost|money }}</dd></div>
            <div class="figure"><dt>{{ 'group.per_person'|trans({count: params.people}) }}</dt><dd>{{ perPerson|money }}<small>{{ 'group.per_person_year'|trans({amount: (perPerson * 52 * lottery.game.drawsPerWeek)|money(0)}) }}</small></dd></div>
        </dl>
    </div>
</section>

<section class="block">
    <div class="block__head">
        <h2>{{ 'group.chances_title'|trans }}</h2>
        <p>{{ 'group.chances_text'|trans }}</p>
    </div>
    <div>
        <dl class="figures">
            <div class="figure"><dt>{{ 'group.jackpot_group'|trans }}</dt><dd>{{ ui.chance(result.jackpot) }}<small>{{ 'group.jackpot_alone'|trans({chance: ui.chance(alone.jackpot)|striptags|trim, grids: alone.grids}) }}</small></dd></div>
            <div class="figure"><dt>{{ 'group.any'|trans }}</dt><dd>{{ ui.chance(result.any) }}</dd></div>
        </dl>
        <div class="table-wrap" style="margin-top: 22px">
            <table>
                <thead><tr><th>{{ 'budget.col_tier'|trans }}</th><th>{{ 'budget.col_match'|trans }}</th><th class="num">{{ 'budget.col_prize'|trans }}</th><th class="num">{{ 'group.col_per_draw'|trans }}</th></tr></thead>
                <tbody>
                {% for t in result.tiers %}
                    <tr>
                        <td>{{ t.rank }}</td>
                        <td class="nowrap">{{ 'common.matches'|trans({main: t.main, bonus: t.bonus}) }}</td>
                        <td class="num nowrap">{{ t.averagePrize|money(0) }}</td>
                        <td class="num nowrap"><strong>{{ ui.chance(t.probability) }}</strong></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="block">
    <div class="block__head">
        <h2>{{ 'group.period_title'|trans({years: params.years}) }}</h2>
        <p>{{ 'group.period_text'|trans({count: draws|integer}) }}</p>
    </div>
    <dl class="figures">
        <div class="figure"><dt>{{ 'group.period_any'|trans }}</dt><dd>{{ ui.chance(overPeriod.any) }}</dd></div>
        <div class="figure"><dt>{{ 'group.period_jackpot'|trans }}</dt><dd>{{ ui.chance(overPeriod.jackpot) }}</dd></div>
        <div class="figure"><dt>{{ 'group.period_cost'|trans }}</dt><dd>{{ (perPerson * draws)|money(0) }}</dd></div>
    </dl>
</section>

<section class="block">
    <div class="block__head">
        <h2>{{ 'group.share_title'|trans }}</h2>
    </div>
    <div style="max-width: 66ch">
        <dl class="figures">
            <div class="figure"><dt>{{ 'group.share_jackpot'|trans({amount: jackpotAmount|money(0)}) }}</dt><dd>{{ share|money(0) }}</dd></div>
            <div class="figure"><dt>{{ 'group.return_rate'|trans }}</dt><dd>{{ (100 * result.returnRate)|num(0) }} %</dd></div>
        </dl>
        <div class="callout" style="margin-top: 22px"><strong>{{ 'group.honest_title'|trans }}</strong> {{ 'group.honest'|trans({percent: (100 * result.returnRate)|num(0)}) }}</div>
    </div>
</section>
{% endblock %}
